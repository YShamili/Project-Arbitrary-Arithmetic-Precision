<project name="ArbitraryArithmetic" default="run" basedir=".">
    <property name="src" value="src"/>
    <property name="build" value="build"/>
    <property name="jar.file" value="build/arbitraryarithmetic.jar"/>

    <!-- clean target -->
    <target name="clean">
        <delete dir="${build}"/>
    </target>

    <!-- compile target -->
    <target name="compile" depends="clean,init">
        <javac srcdir="${src}" destdir="${build}"/>
    </target>

    <!-- initializes the build directory -->
    <target name="init">
        <mkdir dir="${build}"/>
    </target>

    <!-- jar target -->
    <target name="jar" depends="compile">
        <jar destfile="${jar.file}" basedir="${build}">
            <manifest>
                <attribute name="Main-Class" value="arbitraryarithmetic.MyInfArith"/>
            </manifest>
        </jar>
    </target>

    <!-- build target (depends on cleaning and compiling) -->
    <target name="build" depends="clean, compile">
        <!-- Clean and compile the project -->
    </target>

    <!-- runs target -->
    <target name="run" depends="jar">
        <java jar="${jar.file}" fork="true">
            <arg value="int"/>
            <arg value="add"/>
            <arg value="123"/>
            <arg value="456"/>
        </java>
    </target>
</project>
